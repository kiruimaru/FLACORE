/* Liquid Glass: тёплое свечение акцента по краям и «стеклянная» панель плеера. */

QWidget[dataUi="sidebar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @accent-soft, stop:0.55 @panel, stop:1 @panel);
}

QWidget[dataUi="player"] {
    border: 1px solid @border-strong;
}

QListWidget[dataUi="sidebar"]::item:selected {
    border: 1px solid @accent-glow;
}

QPushButton[variant="accent"] {
    border-radius: @radius-sm;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 @accent-hover, stop:1 @accent);
}