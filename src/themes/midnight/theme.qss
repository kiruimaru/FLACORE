/* Midnight: синие градиенты и холодная подсветка выделения. */

QWidget[dataUi="titlebar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @accent-soft, stop:1 transparent);
}

QWidget[dataUi="sidebar"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 @accent-soft, stop:0.6 #0a0f1a, stop:1 #0a0f1a);
}

QWidget[dataUi="card"] {
    border: 1px solid @border;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 @panel, stop:1 @panel-strong);
}

QWidget[dataUi="player"] {
    border: 1px solid @border;
    background: @panel-strong;
}

QListWidget[dataUi="results"]::item:selected {
    border: 1px solid @accent-glow;
}